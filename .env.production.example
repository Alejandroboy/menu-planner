# Скопировать в .env рядом с docker-compose.prod.yml на сервере и заполнить реальными значениями.
# Этот файл читает `docker compose` автоматически (переменные идут в api/db/caddy сервисы).

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=menu_planner

# Домен, на который указывает A-запись сервера (нужен для Let's Encrypt через Caddy)
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Относительный путь — не менять, если api и web обслуживаются через один домен/Caddy
VITE_API_URL=/api
